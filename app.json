{
  "expo": {
    "name": "Inicio Real Estate",
    "slug": "inicio-real-estate",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/iconoIRSprincipaltransparencia.png",
    "userInterfaceStyle": "automatic",
    "scheme": "inicio-real-estate",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.iniciorealestate.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/iconoIRSprincipaltransparencia.png",
        "backgroundColor": "#1e2d32"
      },
      "package": "com.iniciorealestate.app",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/iconoIRSprincipaltransparencia.png"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Permite que Inicio Real Estate acceda a tus fotos para elegir una imagen de perfil."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "00313cfd-82a3-4e8c-8732-8651cbea776b"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/00313cfd-82a3-4e8c-8732-8651cbea776b"
    }
  }
}
